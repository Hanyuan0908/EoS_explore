.DS_Store
# Belokurov's reference clone (has its own git; re-clone on each machine):
#   git clone git@github.com:vasilybelokurov/eos-figures.git
eos-figures/
**/__pycache__/
**/.ipynb_checkpoints/
*.pyc
.mplconfig/
.cache/

# Auriga Au18 work: derived arrays (regenerable from auriga/*.py scripts; several >100MB)
auriga/out/
# External package clone (bitbucket grandrt/auriga_public) — has its own git
auriga/auriga_public_src/
# Bulk simulation dumps kept locally only
jrun003.*.gz

# gastro: raw GASOLINE snapshots and the cached per-star arrays (regenerable
# from prep_gastro.py; the snapshots come from the collaborator, not this repo)
gastro/jrun003.*.0[0-9]*
gastro/out/*_stars.npz
gastro/jrun003.*/
gastro/out/fig5_*.npz
gastro/out/gas_disc_evolution.npz
auriga/out/gas_disc_evolution_au18.npz
auriga/out/gas_disc_evolution_au*.npz
auriga/out/eos_two_origins.npz
